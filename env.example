# ══════════════════════════════════════════════════════════════════════════════
# axiom-repair 环境变量配置模板
#
# 使用方法：
#   本地开发：复制并重命名为 .env.local   → Next.js 自动读取，不提交到 Git
#   PM2 部署：复制并重命名为 .env.production，ecosystem.config.js 会读取它
#   Docker 部署：直接在 docker run -e 参数或 docker-compose.yml 中设置
# ══════════════════════════════════════════════════════════════════════════════


# ──────────────────────────────────────────────────────
# SQL Server 连接（mssql 直连，用于所有 API 路由）
# ──────────────────────────────────────────────────────
DB_SERVER=localhost
# Docker 部署时如果 SQL Server 在宿主机，改为：DB_SERVER=host.docker.internal
DB_DATABASE=AxinRepairDB
DB_USER=AxinUser
DB_PASSWORD=AxinPassword2026!
DB_PORT=1433
DB_ENCRYPT=false
# 内网自签证书设为 true；连接正规 SSL 证书设为 false
DB_TRUST_CERT=true
DB_POOL_MAX=10


# ──────────────────────────────────────────────────────
# Prisma 连接字符串（用于 prisma db push / prisma studio）
# 格式：sqlserver://HOST:PORT;database=DB;user=USER;password=PASS;trustServerCertificate=true
# ──────────────────────────────────────────────────────
DATABASE_URL="sqlserver://localhost:1433;database=AxinRepairDB;user=AxinUser;password=AxinPassword2026!;trustServerCertificate=true"


# ──────────────────────────────────────────────────────
# 文件存储
# STORAGE_MODE: local（默认，存到服务器磁盘）| s3（对象存储）
# ──────────────────────────────────────────────────────
STORAGE_MODE=local
# 本地存储时，文件写入路径（留空则默认使用 ./public/uploads）
UPLOAD_DIR=

# ── 如果使用 S3 / MinIO 对象存储，填写以下配置 ──
# S3_ENDPOINT=https://your-minio-server:9000
# S3_REGION=ap-east-1
# S3_BUCKET=axiom-repair
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_PUBLIC_URL=https://your-cdn-or-minio-url


# ──────────────────────────────────────────────────────
# Next.js 运行端口（生产环境）
# ──────────────────────────────────────────────────────
PORT=3000
HOSTNAME=0.0.0.0
